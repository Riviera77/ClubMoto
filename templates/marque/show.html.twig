{% extends 'base.html.twig' %}

{% block title %}Marques{% endblock %}

{% block body %}

    <div class="container">
        <table class="table mb-5">
            {#correspond à la partie READ (1) READ du CRUD#}
                <tbody>
                        <tr>
                            <th scope="row>">ID</th>              
                            <td scope="row>">{{marque.id}}</td>              
                        </tr>
                        <tr>
                            <th scope="row>">Nom</th>              
                            <td>{{marque.libelle}}</td>
                        </tr>
                </tbody>
            </table>

            <div class="d-grid gap-2 col-4 mx-auto py-3">
                <a href="{{path('marque_index')}}" class="btn btn-lg btn-primary">Retour à la liste</a>
            </div>
    </div>
    

{% endblock %}
